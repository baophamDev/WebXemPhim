PORT=4000
HOST=0.0.0.0
# Danh sách origin được gọi API, cách nhau bằng dấu phẩy.
# Domain *.vercel.app được cho phép sẵn (tắt bằng ALLOW_VERCEL_PREVIEW=false) —
# app trên TV LG là hosted web app nên cũng đi qua nhánh này, không cần thêm gì.
# ALLOW_NULL_ORIGIN=false để chặn 'Origin: null' (chỉ dùng nếu quay lại bản
# đóng gói chạy từ file://, xem docs/webos.md).
WEB_ORIGIN=http://localhost:5173
# Dùng pooler của Supabase (aws-0-<region>.pooler.supabase.com) — KHÔNG dùng
# host db.<ref>.supabase.co: host đó giờ chỉ còn bản ghi IPv6, còn Railway/Vercel
# chỉ có egress IPv4 nên sẽ báo ENETUNREACH mãi mãi. Project này ở Tokyo:
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
DATABASE_POOL_SIZE=10
# Cache server ( readings catalog/movies/search ): Redis thật khi đặt URL này,
# không đặt thì API tự dùng cache RAM trong tiến trình (dev đủ dùng, nhưng mỗi
# instance giữ bản riêng). Trên Railway: Add Plugin Redis là có REDIS_URL;
# Vercel/Upstash: tạo Upstash Redis rồi dán URL dạng rediss://... vào đây.
# REDIS_URL=redis://localhost:6379
# TTL mặc định khi gọi cacheSet không truyền số giây, và trần key của RAM.
CACHE_DEFAULT_TTL=60
CACHE_MEMORY_MAX_KEYS=500
# Nguồn phim duy nhất: VSMOV.
VSMOV_API_URL=https://vsmov.com/api
# Dev: '/api' đi qua proxy của Vite sang localhost:4000.
# Production (Vercel): PHẢI là URL đầy đủ của API trên Railway, vì Vercel
# không proxy /api — nếu để '/api' thì web sẽ hiện "API ngoại tuyến".
#   VITE_API_URL=https://<app>.up.railway.app/api
VITE_API_URL=/api

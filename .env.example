PORT=4000
HOST=0.0.0.0
# Danh sách origin được gọi API, cách nhau bằng dấu phẩy.
# Domain *.vercel.app được cho phép sẵn (tắt bằng ALLOW_VERCEL_PREVIEW=false) —
# app trên TV LG là hosted web app nên cũng đi qua nhánh này, không cần thêm gì.
# ALLOW_NULL_ORIGIN=false để chặn 'Origin: null' (chỉ dùng nếu quay lại bản
# đóng gói chạy từ file://, xem docs/webos.md).
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_SSL=true
DATABASE_POOL_SIZE=10
# Nguồn catalog, cách nhau bằng dấu phẩy. THỨ TỰ = ƯU TIÊN: nguồn đầu được gọi
# trước, nguồn sau chỉ dùng khi nguồn trước lỗi hoặc không có khả năng đó.
# Nguồn 'playable' (vsmov) mới có link tập; nguồn 'metadata' (tmdb) chỉ lấp chỗ
# trống (poster, mô tả, diễn viên) và không bao giờ ghi đè.
# Xem trạng thái từng nguồn: GET /api/providers
CATALOG_SOURCES=vsmov,tmdb
# CATALOG_PROVIDER là tên cũ, chỉ còn đọc để không phá deploy đang chạy.
VSMOV_API_URL=https://vsmov.com/api
# TMDB — nguồn metadata có giấy phép. Chỉ cần MỘT trong hai khoá:
#   TMDB_ACCESS_TOKEN: token v4 (Bearer), lấy ở themoviedb.org > Settings > API
#   TMDB_API_KEY: khoá v3 (đi kèm query string), dùng khi không có token v4
# Không đặt khoá nào thì nguồn tmdb tự tắt và API vẫn chạy với các nguồn còn lại.
# TMDB_ACCESS_TOKEN=
# TMDB_API_KEY=
TMDB_LANGUAGE=vi-VN
# TMDB_API_URL=https://api.themoviedb.org/3
# TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
# Khoá ký link playlist con của bộ lọc quảng cáo (xem docs/ads.md). Không đặt thì
# mỗi tiến trình tự sinh — chỉ cần đặt khi chạy nhiều instance API song song.
# STREAM_SECRET=doi-thanh-chuoi-ngau-nhien-dai
# Dev: '/api' đi qua proxy của Vite sang localhost:4000.
# Production (Vercel): PHẢI là URL đầy đủ của API trên Railway, vì Vercel
# không proxy /api — nếu để '/api' thì web sẽ hiện "API ngoại tuyến".
#   VITE_API_URL=https://<app>.up.railway.app/api
VITE_API_URL=/api

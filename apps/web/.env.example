# Web gọi thẳng 3 nguồn phim từ trình duyệt — KHÔNG còn backend (xem src/sources.ts).
# Để trống là chạy được ngay với giá trị mặc định dưới đây; chỉ đặt khi cần đổi nguồn.

# NguonC — nguồn chính dựng danh sách/menu + embed thật.
VITE_NGUONC_API_URL=https://phim.nguonc.com/api
# KKPhim — nguồn chính để PHÁT (có link_m3u8 thật, phát thẳng không cần iframe).
VITE_KKPHIM_API_URL=https://phimapi.com
# VSMOV — chặng cuối cho phần chữ (catalog/tìm kiếm); detail bị chặn CORS nên
# không phát được trực tiếp trên trình duyệt.
VITE_VSMOV_API_URL=https://vsmov.com/api

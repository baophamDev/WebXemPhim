<?xml version="1.0" encoding="utf-8"?>
<!--
  Biểu tượng: vòng tròn + tam giác play, đúng hai hình đã dùng ở bản webOS.

  Vẽ bằng vector chứ không dùng PNG: repo không có sẵn bộ icon ở mọi mật độ, mà
  một file vector thì tự đúng ở mọi kích thước, sửa được bằng trình soạn thảo, và
  đọc được trong diff. Kích thước 108x108 là khổ chuẩn của adaptive icon; hình
  nằm gọn trong vùng an toàn 66x66 ở giữa (26..82) nên không bị mặt nạ cắt cụt.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
  <path
      android:pathData="M26,54 a28,28 0 1,0 56,0 a28,28 0 1,0 -56,0"
      android:fillColor="#00000000"
      android:strokeColor="@color/app_accent"
      android:strokeWidth="5" />
  <path
      android:pathData="M46,40 L70,54 L46,68 Z"
      android:fillColor="@color/app_accent" />
</vector>
